PORT=3000
NODE_ENV=development
API_KEY=secret_api_key_whatsapp_tsi

# Session storage directory
SESSION_DIR=./sessions

# Redis configuration for BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Webhook configuration (target backend URL for incoming messages and status)
WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook
WEBHOOK_SECRET=secret_webhook_key

# Message Queue Anti-Ban settings
MIN_MESSAGE_DELAY_MS=2000
MAX_MESSAGE_DELAY_MS=4000
ENABLE_TYPING_SIMULATION=true
